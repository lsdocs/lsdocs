source: crates/cli/tests/sample_site.rs
expression: html
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Configuration | lsdocs sample</title>
<style>
:root {
  --fg: #1f2328; --muted: #59636e; --bg: #ffffff; --soft: #f6f8fa;
  --border: #d1d9e0; --accent: #0969da;
}
@media (prefers-color-scheme: dark) {
  :root {
    --fg: #e6edf3; --muted: #9198a1; --bg: #0d1117; --soft: #151b23;
    --border: #3d444d; --accent: #4493f8;
  }
}
* { box-sizing: border-box; }
body {
  margin: 0; color: var(--fg); background: var(--bg);
  font: 16px/1.6 system-ui, -apple-system, "Segoe UI", sans-serif;
}
header, main, footer { max-width: 48rem; margin: 0 auto; padding: 0 1rem; }
header { padding-top: 1rem; padding-bottom: 1rem; border-bottom: 1px solid var(--border); }
header a { color: var(--fg); font-weight: 600; text-decoration: none; }
main { padding-top: 1rem; padding-bottom: 2rem; }
footer { color: var(--muted); font-size: 0.875rem; padding-bottom: 2rem; }
a { color: var(--accent); }
h1, h2, h3, h4, h5, h6 { line-height: 1.25; margin: 1.5em 0 0.5em; }
code, pre { font-family: ui-monospace, "Cascadia Code", Menlo, monospace; font-size: 0.875em; }
code { background: var(--soft); padding: 0.1em 0.3em; border-radius: 4px; }
pre { background: var(--soft); padding: 1rem; overflow-x: auto; border-radius: 6px; }
pre code { background: none; padding: 0; }
blockquote { margin: 0; padding: 0 1rem; color: var(--muted); border-left: 4px solid var(--border); }
table { border-collapse: collapse; }
th, td { border: 1px solid var(--border); padding: 0.3rem 0.75rem; }
img { max-width: 100%; }
.toc { background: var(--soft); border: 1px solid var(--border); border-radius: 6px; padding: 0.5rem 1rem; }
.toc ul { margin: 0; padding-left: 1.25rem; }
.toc p { margin: 0; }
</style>
</head>
<body>
<header><a href="../index.html">lsdocs sample</a></header>
<main>
<h1 id="config">Configuring a site</h1>
<div class="toc"><ul>
<li><p><a href="#options">Options</a></p>
</li>
<li><p><a href="#plugins">Plugins</a></p>
</li>
</ul>
</div>
<blockquote>
<p>Settings live in <code>lsdocs.toml</code>, next to the <code>docs/</code> directory.</p>
</blockquote>
<h2 id="options">Options</h2>
<table>
<tr><th>Key</th><th style="text-align: center">Default</th><th>Meaning</th></tr>
<tr><td><code>build.source_dir</code></td><td style="text-align: center"><code>docs</code></td><td>Where pages are read from</td></tr>
<tr><td><code>build.output_dir</code></td><td style="text-align: center"><code>site</code></td><td>Where the site is written</td></tr>
</table>
<h2 id="plugins">Plugins</h2>
<pre><code class="language-toml">[[plugins]]
name = &quot;markdown&quot;
builtin = &quot;parser-markdown&quot;
</code></pre>
<details>
<summary>Raw HTML passes through</summary>
<p>Content inside is still Markdown.</p>
</details>
<p>Escaping works: 1 &lt; 2 &amp;&amp; &quot;quotes&quot; stay safe.</p>
</main>
<footer>Built with lsdocs</footer>
</body>
</html>
